# Codebase Quality and Compliance (CQC)
#
# Every check runs through one command, `coldframe check`, which is the same
# command a developer runs locally. A CI-only invocation is a CI-only failure
# mode, and those are the expensive ones to debug.
#
# No path filters, deliberately. If other pipelines gate on this one they need a
# result at every commit, and a gate cannot tell "still running" from "never
# ran". A docs-only run is cheaper than a downstream pipeline waiting out a
# poll timeout and then failing.

trigger:
  batch: true
  branches:
    include:
      - main

pr:
  branches:
    include:
      - main

parameters:
  - name: pythonVersion
    type: string
    default: "{{ python_version }}"

  - name: gates
    displayName: "Gates to run, blank means the pyproject.toml list"
    type: string
    default: ""

  - name: vmImage
    type: string
    default: "ubuntu-latest"

variables:
  - name: junitDir
    value: $(Build.ArtifactStagingDirectory)/quality

stages:
  - stage: Quality
    displayName: "Codebase Quality and Compliance"
    jobs:
      - job: gates
        displayName: "Run quality gates"
        pool:
          vmImage: ${{ parameters.vmImage }}
        steps:
          - task: UsePythonVersion@0
            displayName: "Use Python ${{ parameters.pythonVersion }}"
            inputs:
              versionSpec: "${{ parameters.pythonVersion }}"

          - script: |
              set -euo pipefail
              python -m pip install --upgrade pip
              pip install -e ".[dev]"
            displayName: "Install the project and its dev dependencies"

          # No `|| true` here. The step below owns whether the build fails, and
          # it needs the JUnit files to decide, so this command must be allowed
          # to exit non-zero without killing the job. `continueOnError` does
          # that while still marking the step, which `|| true` hides entirely.
          - script: |
              set -uo pipefail
              coldframe check \
                --junit-dir "$(junitDir)" \
                --format github \
                ${{ parameters.gates }}
              echo "coldframe exit code: $?"
            displayName: "Run coldframe check"
            continueOnError: true

          # Gating happens here rather than on the exit code above, so the Tests
          # tab shows which file broke which rule instead of a wall of log text.
          # `<error>` entries, a gate that could not run, fail the build the
          # same way `<failure>` entries do.
          - task: PublishTestResults@2
            displayName: "Publish gate results"
            condition: succeededOrFailed()
            inputs:
              testResultsFormat: JUnit
              testResultsFiles: "$(junitDir)/junit-*.xml"
              testRunTitle: "Codebase Quality and Compliance"
              mergeTestResults: true
              failTaskOnFailedTests: true

          - task: PublishBuildArtifacts@1
            displayName: "Publish the raw gate output"
            condition: succeededOrFailed()
            inputs:
              PathtoPublish: "$(junitDir)"
              ArtifactName: quality
